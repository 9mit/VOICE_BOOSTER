{
  "manifest_version": 3,
  "name": "Volumify: Volume Booster & Sound Equalizer",
  "version": "1.0.7",
  "description": "Boost volume up to 500% with Volumify sound booster & equalizer. Perfect for YouTube, Spotify, Netflix, Prime Video, and Twitch.",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-volume-booster@extensions",
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; default-src 'none';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Volumify: Volume Booster & Sound Equalizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-booster": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Volume Booster On/Off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "platform-detector.js",
        "audio-engine.js",
        "spa-navigator.js",
        "ui-controller.js",
        "message-bridge.js",
        "content-script.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
